{
  "name": "tongkrongan-tech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "db:local": "wrangler d1 migrations apply tongkrongan --local",
    "db:remote": "wrangler d1 migrations apply tongkrongan --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test --experimental-strip-types --experimental-sqlite tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "framer-motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.158.0"
  }
}
