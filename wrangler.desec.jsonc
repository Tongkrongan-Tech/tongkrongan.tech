{
  // Deployment uji deSEC: Worker terpisah di workers.dev, database sendiri, tanpa custom domain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tongkrongan-desec",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tongkrongan-desec", "database_id": "2ab2a7ce-bfcd-4899-8f47-b08cd534cd9f", "migrations_dir": "migrations" }
  ],
  "workers_dev": true,
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "BASE_DOMAIN": "floworks.my.id",
    "DNS_PROVIDER": "desec",
    "QUOTA": "3",
    "DNS_MODE": "live"
  }
}
