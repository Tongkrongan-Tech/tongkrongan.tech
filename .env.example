# Contoh variabel lingkungan. Salin ke .env bila kamu memerlukannya. Jangan commit berkas .env.
#
# Catatan: Cloudflare Workers dan wrangler memakai berkas .dev.vars, bukan .env.
# Untuk pengembangan lokal, salin .dev.vars.example ke .dev.vars dan jalankan lewat wrangler.
# Berkas ini mendokumentasikan nama variabel yang dipakai project.

# Mode DNS. live untuk produksi, mock untuk lokal.
DNS_MODE=mock

# Domain induk.
BASE_DOMAIN=tongkrongan.tech

# Kuota subdomain per akun.
QUOTA=3

# Wajibkan verifikasi email saat pendaftaran.
REQUIRE_EMAIL_VERIFY=1

# Alamat pengirim email, misalnya Tongkrongan <halo@tongkrongan.tech>.
EMAIL_FROM=

# Rahasia. Isi lewat .dev.vars (lokal) atau lewat wrangler secret put NAMA (produksi).
CF_API_TOKEN=
CF_ZONE_ID=
ADMIN_TOKEN=
RESEND_API_KEY=
TURNSTILE_SECRET=
TURNSTILE_SITEKEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
VERCEL_TOKEN_KEY=
SAFE_BROWSING_KEY=

# Adapter DNS deSEC (opsional). Set DNS_PROVIDER=desec untuk memakai deSEC.
DNS_PROVIDER=
DESEC_TOKEN=
